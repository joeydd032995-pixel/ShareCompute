diff --git a/mlx/c/distributed_group.cpp b/mlx/c/distributed_group.cpp
index a662ec6..d41b5d4 100644
--- a/mlx/c/distributed_group.cpp
+++ b/mlx/c/distributed_group.cpp
@@ -6,6 +6,16 @@
 #include "mlx/c/error.h"
 #include "mlx/c/private/mlx.h"
 
+extern "C" int mlx_distributed_group_free(mlx_distributed_group group) {
+  try {
+    mlx_distributed_group_free_(group);
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+
 extern "C" int mlx_distributed_group_rank(mlx_distributed_group group) {
   try {
     return mlx_distributed_group_get_(group).rank();
@@ -63,3 +73,12 @@ extern "C" mlx_distributed_group mlx_distributed_init(
     return mlx_distributed_group_new_();
   }
 }
+
+extern "C" bool mlx_distributed_finalize(void) {
+  try {
+    return mlx::core::distributed::finalize();
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return false;
+  }
+}
diff --git a/mlx/c/distributed_group.h b/mlx/c/distributed_group.h
index 43aa2ae..1649a2e 100644
--- a/mlx/c/distributed_group.h
+++ b/mlx/c/distributed_group.h
@@ -23,6 +23,15 @@ typedef struct mlx_distributed_group_ {
   void* ctx;
 } mlx_distributed_group;
 
+/**
+ * Free the group.
+ *
+ * Releases this handle's reference to the underlying group. The group itself
+ * is destroyed once no references remain -- see mlx_distributed_finalize(),
+ * which drops the one the library holds internally.
+ */
+int mlx_distributed_group_free(mlx_distributed_group group);
+
 /**
  * Get the rank.
  */
@@ -51,6 +60,25 @@ mlx_distributed_group mlx_distributed_init(
     bool strict,
     const char* bk /* may be null */);
 
+/**
+ * Release the groups cached by mlx_distributed_init().
+ *
+ * Without this, mlx_distributed_init() can only ever return the group built by
+ * the first call: it memoises what it creates, so a re-init after a topology
+ * change hands back the stale group and ignores the rewritten hostfile.
+ *
+ * Free every mlx_distributed_group handle you hold before calling this --
+ * each one is a reference, and the group is only torn down when the last one
+ * goes. Quiesce the ring first; a collective in flight over a group being torn
+ * down is undefined.
+ *
+ * Returns true if the groups were torn down. False means a handle is still
+ * held, so nothing was destroyed and nothing was changed -- a subsequent
+ * mlx_distributed_init() returns the same group as before. Find the handle you
+ * did not free rather than calling again; the second call fails identically.
+ */
+bool mlx_distributed_finalize(void);
+
 /**@}*/
 
 #ifdef __cplusplus
