  private:
+  // Run a collective body, recording any failure rather than letting it escape.
+  //
+  // Nothing may throw out of a dispatched task. CommandEncoder::dispatch binds
+  // the callable and hands it to scheduler::enqueue, and there is no try/catch
+  // anywhere in that path -- so an escaping exception unwinds a scheduler
+  // thread with no handler and calls std::terminate(), killing the process.
+  //
+  // The failure is instead stashed and rethrown from check_healthy(), which
+  // runs on the caller's own thread. Note this also contains the throws that
+  // were already reachable from inside these lambdas (unsupported send/recv
+  // targets, and an all_reduce too small to split), each of which could
+  // terminate the process today.
+  template <typename F>
+  void run_guarded(F&& body) {
+    try {
+      body();
+    } catch (...) {
+      std::lock_guard<std::mutex> lock(failure_mutex_);
+      if (!failure_) {
+        // Keep the first failure: it names what actually broke the ring.
+        failure_ = std::current_exception();
+      }
+    }
+  }
