-    return distributed::init();
-  }
+  auto g = group.has_value() ? group.value() : distributed::init();
+
+  // Surface a failure from an earlier collective here, while we are still on
+  // the caller's thread and an exception can legally propagate out through the
+  // C API. Every entry point in this file funnels through to_group, so this
+  // single call covers all of them.
+  g.raw_group()->check_healthy();
