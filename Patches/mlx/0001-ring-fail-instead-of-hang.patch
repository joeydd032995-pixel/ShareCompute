+  // Rethrow the failure of an earlier asynchronous collective, if there was
+  // one.
+  //
+  // Backends whose errors surface synchronously need not override this. The
+  // ring backend does: its transfers run on scheduler threads, where an
+  // exception cannot legally escape, so it records the failure and rethrows it
+  // here instead -- on the caller's own thread, where it can propagate.
+  virtual void check_healthy() {}
 };
 
