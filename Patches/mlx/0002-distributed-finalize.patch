+bool finalize() {
+  auto& cache = backends();
+
+  // How many cache entries alias each impl: init() stores every group twice,
+  // once under "any" and once under the resolved backend name.
+  std::unordered_map<detail::GroupImpl*, long> cache_refs;
+  for (const auto& entry : cache) {
+    cache_refs[entry.second.get()]++;
+  }
