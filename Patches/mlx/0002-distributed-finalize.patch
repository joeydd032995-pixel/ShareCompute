+++ b/mlx/distributed/distributed.h
@@ -58,4 +58,36 @@ struct MLX_API Group {
  */
 MLX_API Group init(bool strict = false, const std::string& bk = "any");
 
+/**
+ * Release the cached groups so that a subsequent init() builds a new one.
+ *
+ * init() memoises the group it creates, so on its own it can never honour a
+ * changed hostfile: the second call returns the first call's group. Dropping
+ * the cached references here runs each backend's existing teardown -- for the
+ * ring backend that is ~RingGroup() closing its sockets and ~SocketThread()
+ * joining its worker.
+ *
+ * A cached impl is only destroyed once every other reference to it is gone, so
+ * callers must release their own Group handles first. Calling a collective on
+ * a group whose ring has been torn down is undefined; quiesce the ring before
+ * calling this.
+ *
+ * Returns true if the cached groups were torn down. False means a Group handle
+ * is still held somewhere, so nothing could be destroyed -- and in that case
+ * nothing is changed at all: the cache is left intact and the next init()
+ * returns the same group it would have before.
+ *
+ * Treat a false as an error rather than retrying. The surviving reference is
+ * in the caller's own code, so calling again without releasing it will fail
+ * identically.
+ *
+ * This call is internally synchronised against init(), so the two are safe to
+ * call concurrently and the check-then-teardown is atomic. That does not make
+ * the *use counts* exact: a Group copied or destroyed on another thread changes
+ * a count without touching the cache, so a concurrent holder can still be
+ * missed. Only the quiesce precondition above rules that out -- the lock
+ * protects the cache, not your handles.
+ */
+MLX_API bool finalize();
+
 } // namespace mlx::core::distributed
