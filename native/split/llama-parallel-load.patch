+// Contexts that load in parallel report progress through this. The real callback is called by one thread at a time,
+// and once it returns false every thread stops asking it and returns false.
+struct sc_progress_guard {
+    llama_progress_callback callback;
+    void * user_data;
+    std::mutex mutex;
+    std::atomic<bool> cancelled{false};
+};
+
+static bool sc_progress_guarded(float progress, void * data) {
+    auto * guard = (sc_progress_guard *) data;
+    std::lock_guard<std::mutex> lock(guard->mutex);
+    if (guard->cancelled) {
+        return false;
+    }
+    if (guard->callback && !guard->callback(progress, guard->user_data)) {
+        guard->cancelled = true;
+        return false;
+    }
+    return true;
+}
